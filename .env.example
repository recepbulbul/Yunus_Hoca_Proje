# Copy to .env and fill in. Never commit .env.
# All secrets are read via pydantic-settings with the MINDEX_ prefix.

MINDEX_ENV=development
MINDEX_LOG_LEVEL=INFO

# PostgreSQL + pgvector
MINDEX_DATABASE_URL=postgresql+psycopg://mindex:mindex@localhost:5432/mindex

# Redis Streams (experiment worker queue + live broadcast)
MINDEX_REDIS_URL=redis://localhost:6379/0

# Auth (F1). Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
MINDEX_JWT_SECRET=change-me
MINDEX_JWT_TTL_MINUTES=60

# Local LLM (llama.cpp llama-server, OpenAI-compatible)
MINDEX_LLM_BASE_URL=http://localhost:8080/v1
MINDEX_LLM_MODEL=qwen3.5-9b-q4_k_m
MINDEX_LLM_TIMEOUT_SECONDS=30
MINDEX_LLM_MAX_RETRIES=2

# Embeddings
MINDEX_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Langfuse (self-hosted)
MINDEX_LANGFUSE_HOST=http://localhost:3000
MINDEX_LANGFUSE_PUBLIC_KEY=
MINDEX_LANGFUSE_SECRET_KEY=
